# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Ticket price: either an existing Stripe Price ID, or an amount in cents
STRIPE_PRICE_ID=
TICKET_AMOUNT_CENTS=2000
TICKET_CURRENCY=eur

# Redirect URLs after payment.
# This backend serves the /merci.html and /annule.html pages itself (public/ folder),
# so no separate website is needed. Locally, keep localhost. Once deployed
# (Render, Railway, VPS...), replace with your public domain, e.g.:
# https://your-domain.com/merci.html
SUCCESS_URL=http://localhost:4242/merci.html
CANCEL_URL=http://localhost:4242/annule.html

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_xxx
EMAIL_FROM="My Event <tickets@your-domain.com>"

# Info shown on the sales page (/)
EVENT_NAME="My Event"
EVENT_DATE="[DATE TO FILL IN]"
EVENT_LOCATION="[LOCATION TO FILL IN]"
EVENT_DESCRIPTION="[DESCRIPTION TO FILL IN]"

# Server
PORT=4242

# Secret key protecting the entry verification endpoint
STAFF_API_KEY=change-me
