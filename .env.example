# PayPal (personal account, no PayPal Developer app needed)
# Your paypal.me username, e.g. for https://paypal.me/johndoe it's "johndoe"
PAYPAL_ME_USERNAME="SousLeBaobab2026"
# The email address linked to your PayPal account (used to check IPN notifications
# really came in on your account before issuing a ticket)
PAYPAL_RECEIVER_EMAIL="Sous.le.baobab.26@gmail.com"
# "sandbox" while testing with a PayPal Sandbox account, "live" for the real event
PAYPAL_ENV=live

# Ticket price
TICKET_AMOUNT_CENTS=5000
TICKET_CURRENCY=eur

# Email (sent via your own Gmail account, no domain required)
# The Gmail address you send tickets from
GMAIL_USER=your.address@gmail.com
# A Gmail "App Password" (not your normal password) - generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Must use the same address as GMAIL_USER (Gmail rejects mismatched "from")
EMAIL_FROM="My Event <your.address@gmail.com>"

# Info shown on the sales page (/)
#EVENT_NAME="My Event"
#EVENT_DATE="[DATE TO FILL IN]"
#EVENT_LOCATION="[LOCATION TO FILL IN]"
#EVENT_DESCRIPTION="[DESCRIPTION TO FILL IN]"
#EVENT_INCLUDES="[WHAT'S INCLUDED, OPTIONAL - e.g. Includes brunch + 1 welcome drink]"

EVENT_NAME="SOUS LE BAOBAB"
EVENT_DATE="03 OCTOBER 2026 - 13:00 Uhr"
EVENT_LOCATION="LYF EAST HOTEL | Lindleystraße 17, 60314 Frankfurt am Main, Germany"
EVENT_DESCRIPTION="<strong style=\"font-size:18px\">Welcome to Sous Le Baobab</strong>\n\nSous Le Baobab was created from a simple idea: bring people together around good food and good stories.\n\nInspired by Cameroon and the flavours we grew up with, this brunch is a way to share a little piece of home while discovering it through a fresh and modern experience.\n\nExpect generous plates, familiar flavours, new discoveries and, most importantly, a table where everyone is welcome.\n\nWhether you know Cameroonian food or you are trying it for the very first time, come as you are, sit with us, and enjoy the moment.\n\nSharing stories. Sharing flavours."
EVENT_INCLUDES="INCLUDES BRUNCH + 1 WELCOME DRINK"

# Server
PORT=4242

# Secret key protecting the entry verification endpoint
STAFF_API_KEY=change-me
